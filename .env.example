# =======================================================
# Klean Max Pro — Smart Quotation Automation System
# Environment Configuration Variables
# =======================================================

# 1. Project & Security
PROJECT_NAME="Klean Max Pro QMS"
SECRET_KEY="your-secure-random-jwt-secret-key-replace-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 2. Database Connection (Supabase PostgreSQL / Local PostgreSQL)
# Example for Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Example for Local SQLite: sqlite:///./kleanmaxpro.db
DATABASE_URL="sqlite:///./kleanmaxpro.db"

# 3. Supabase Credentials (from Supabase Project Settings -> API)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# 4. Regional & Tax Defaults
DEFAULT_STATE_CODE="33" # 33 is Tamil Nadu State Code

# 5. CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "https://kleanmaxpro-qms.vercel.app"]
