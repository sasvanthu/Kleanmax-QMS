# ==============================================================================
# Klean Max Pro QMS — Multi-Company Cloud Architecture
# Stack: Supabase (PostgreSQL) + Railway (FastAPI) + Vercel (React Frontend)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RAILWAY BACKEND ENVIRONMENT VARIABLES (Configure in Railway Dashboard)
# ------------------------------------------------------------------------------
PROJECT_NAME="Klean Max Pro QMS"
SECRET_KEY="replace-with-a-secure-random-64-char-string-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Port: Railway provides $PORT automatically. Default fallback is 8000.
PORT=8000

# ------------------------------------------------------------------------------
# 2. SUPABASE DATABASE CONNECTION (Configure in Railway as DATABASE_URL)
# ------------------------------------------------------------------------------
# In Supabase: Go to Project Settings -> Database -> Connection String -> URI
# Use Transaction Pooler (port 6543) or Session Pooler (port 5432):
# Example: postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require"

# Supabase API Credentials (Optional: for direct Supabase Auth or Storage)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# State Code default for India GST (33 = Tamil Nadu)
DEFAULT_STATE_CODE="33"

# CORS: Allow Vercel frontend domain(s) and local development
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "https://your-frontend.vercel.app", "*"]

# ------------------------------------------------------------------------------
# 3. VERCEL FRONTEND ENVIRONMENT VARIABLES (Configure in Vercel Project Settings)
# ------------------------------------------------------------------------------
# Point to your Railway backend deployment URL (including /api):
VITE_API_BASE_URL="https://your-backend-service.up.railway.app/api"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
