# Backend API Base URL (Railway Deployment URL)
# In development or when using Vercel rewrites: leave empty or use /api
# In production with direct Railway API connection:
VITE_API_BASE_URL=https://your-backend-service.up.railway.app/api

# Supabase Credentials (from Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
